{
	"name": "effect-cli-skills",
	"version": "0.2.0",
	"description": "A read-only `skills` command for Effect v4 CLIs: ship agent skills inside your binary",
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.16.1",
	"exports": {
		".": "./src/index.ts",
		"./embed": "./src/embed.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"check:type": "tsc --noEmit",
		"check:lint": "biome check",
		"format": "biome check --write",
		"test": "bun test"
	},
	"peerDependencies": {
		"effect": "^4.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@effect/platform-bun": "4.1.4",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"effect": "4.1.4",
		"typescript": "6.0.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fdarian/effect-cli-skills.git"
	},
	"keywords": [
		"effect",
		"cli",
		"agent-skills",
		"bun"
	]
}
